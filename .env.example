# Copia este archivo como .env (misma carpeta que app.py) y rellénalo.
# .env NO se sube a GitHub (está en .gitignore).

# OpenAI (API, no la suscripción de ChatGPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low / medium / high  (más calidad = más caro y más lento)
OPENAI_IMAGE_QUALITY=medium

# Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
